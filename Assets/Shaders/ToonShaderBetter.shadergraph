    "m_Name": "LightData (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -5277.60009765625,
            "y": 1341.5999755859375,
            "width": 211.2001953125,
            "height": 141.599853515625
        }
    },
    "m_Slots": [
        {
            "m_Id": "db6d2772f15a4fab8657e7128a21d307"
        },
        {
            "m_Id": "b31f54ee2364462fbf5136e587acc56f"
        },
        {
            "m_Id": "34c2ecce61dc423489b8539d6b3ba8c0"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 0,
    "m_FunctionName": "LightData",
    "m_FunctionSource": "8f6b6ce8b9eb9eb438704f0ad900b136",
    "m_FunctionBody": "#pragma multi_compile _ _MAIN_LIGHT_SHADOWS\\r\\n#pragma multi_compile _ _MAIN_LIGHT_SHADOWS_CASCADE\\r\\n#pragma multi_compile _ _ADDITIONAL_LIGHT_SHADOWS\\r\\n#pragma multi_compile _ _SHADOWS_SOFTD\\n#ifndef SHADERGRAPH_PREVIEW\\r\\n#include \\\"Packages/com.unity.render-pipelines.universal/ShaderLibrary/Lighting.hlsl\\\"\\r\\n#endif\\n#ifdef SHADERGRAPH_PREVIEW\\r\\n    Direction = float3(0.5, 0.5, 0);\\r\\nLightPos=half3(0.5,0.5,0);\\nLightColor = float3(0.5, 0.5, 0);\\r\\n    DistanceAtten = 1;\\r\\n    ShadowAtten = 1;\\r\\n#else\\r\\n    float4 shadowCoord = TransformWorldToShadowCoord(WorldPos);\\r\\n\\r\\n    Light mainLight = GetMainLight(shadowCoord);\\r\\n    Direction = mainLight.direction;\\r\\nLightColor = mainLight.color;\\r\\n    DistanceAtten = mainLight.distanceAttenuation;\\r\\n    ShadowAtten = mainLight.shadowAttenuation;\\r\\nLightPos=_MainLightPosition;\\n#endif"
}

